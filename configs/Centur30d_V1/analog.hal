# Load scale components for our 2 analog inputs
loadrt scale count=2
addf scale.0 servo-thread
addf scale.1 servo-thread

#loadrt conv_float_s32 count=1
#addf conv-float-s32.0 servo-thread


# Tell halui to accept direct float values for feed override
setp halui.feed-override.direct-value true
setp halui.spindle.0.override.direct-value true
#setp halui.spindle.0.override.count-enable true

#setp halui.spindle.0.override.scale 0.01



########FEED OVERRIDE#################
# Scale it: If your pot uses a 5V reference, 5V input = 100% (1.0) override multiplier
# Gain = 1 / Max expected voltage -> 1 / 24.0 = 0.0417

# Configure the scale mapping (Example: 0V = 0% override, 24V = 120% override)
setp scale.0.gain 0.05       # Formula: Max Override (1.2) / Max Voltage (24) = 0.05
setp scale.0.offset 0.0      # Adjust offset if you want a minimum threshold floor

# Connect the scaled result to LinuxCNC's motion override pin
net feed-override-scaled scale.0.out => motion.adaptive-feed


# Route the Mesa Analog input through the scale component and into HALUI
net raw-pot-voltage    <= m2_7i92.0.7i76.0.0.analogin0 => scale.0.in
net scaled-feed-factor <= scale.0.out  => halui.feed-override.value




########SPINDLE OVERRIDE#################
# Raw voltage from Mesa Input 1 goes into scale.1

# Scale it similarly 
setp scale.1.gain 0.01
setp scale.1.offset 0.0

# Connect 7i76 analog input to scale component input (adjust pin name to your specific setup)
net spindle-override-raw hm2_7i92.0.7i76.0.0.analogin1 => scale.0.in

# Set scale and offset parameters (example mapping)
setp scale.1.scale 0.1
setp scale.1.offset 0.0

# Enable direct value mode and link to spindle override

net spindle-override-scaled scale.1.out => halui.spindle.0.override.value 





























